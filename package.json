{
    "name": "@postalsys/email-text-tools",
    "version": "3.0.1",
    "description": "Email text tools",
    "type": "module",
    "main": "./dist/cjs/index.js",
    "types": "./dist/cjs/index.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/lib/*"
            ],
            "index": [
                "dist/cjs/index.d.ts"
            ],
            "index.js": [
                "dist/cjs/index.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./index": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./index.js": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./lib/*.js": {
            "import": "./dist/esm/lib/*.js",
            "require": "./dist/cjs/lib/*.js"
        },
        "./lib/*": {
            "import": "./dist/esm/lib/*.js",
            "require": "./dist/cjs/lib/*.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --test test/*.test.cjs test/package/*.test.cjs test/package/*.test.mjs",
        "pretest:coverage": "npm run build",
        "test:coverage": "node --test --experimental-test-coverage test/*.test.cjs",
        "test:watch": "node --test --watch test/*.test.cjs",
        "pretest:cjs": "npm run build",
        "test:cjs": "NODE_OPTIONS=--no-experimental-require-module node --test test/*.test.cjs test/package/*.test.cjs",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install && npm run check:vendor",
        "check:vendor": "node scripts/check-vendor-advisories.cjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/postalsys/email-text-tools.git"
    },
    "keywords": [],
    "author": "Postal Systems OÜ",
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "bugs": {
        "url": "https://github.com/postalsys/email-text-tools/issues"
    },
    "homepage": "https://github.com/postalsys/email-text-tools#readme",
    "devDependencies": {
        "@types/he": "1.2.3",
        "@types/html-to-text": "9.0.4",
        "@types/jsdom": "30.0.0",
        "@types/node": "22.20.5",
        "esbuild": "0.28.2",
        "eslint": "10.15.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.14.0",
        "jsdom": "31.0.1",
        "juice": "12.2.3",
        "prettier": "3.10.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2"
    },
    "dependencies": {
        "@postalsys/email-content": "0.1.22",
        "dompurify": "3.4.18",
        "he": "1.2.0",
        "html-to-text": "10.0.1",
        "linkify-it": "6.1.0",
        "node-html-parser": "9.0.7",
        "tlds": "1.261.0"
    },
    "overrides": {
        "minimatch": "11.0.8"
    }
}
